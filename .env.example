# Copia este fichero a .env y rellena los valores.
# .env NUNCA se commitea (está en .gitignore).

# Token que te da @BotFather al crear el bot
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Tu chat_id personal. Para obtenerlo: escribe algo a tu bot y abre
# https://api.telegram.org/bot<TOKEN>/getUpdates -> result[0].message.chat.id
TELEGRAM_CHAT_ID=123456789
