[Unit]
Description=SnipeBot - ciclo unico de vigilancia Wallapop/Vinted
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Ajusta estas tres rutas y el usuario a tu instalacion real.
User=snipebot
WorkingDirectory=/opt/snipebot
ExecStart=/opt/snipebot/.venv/bin/python /opt/snipebot/main.py

# Endurecimiento basico. Quita/ajusta si tu distro no lo soporta.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
